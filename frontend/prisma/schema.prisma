generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash    String?
  emailVerifiedAt DateTime?
  tokenVersion    Int       @default(0)
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name            String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl       String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role            String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  verificationCodes                VerificationCode[]
  uploads                          FileUpload[]
  notifications                    Notification[]
  notifPrefs                       NotificationPreferences?
  orders                           Order[]
  oauthAccounts                    OAuthAccount[]
  adminActions                     AdminAction[]
  consultationsProvided            Consultation[]
  materniteProvided                Maternite[]
  nutritionsProvided               Nutrition[]
  vaccinationsProvided             Vaccination[]
  hospitalisationsProvided         Hospitalisation[]
  planificationsFamilialesProvided PlanificationFamiliale[]
  registerClosures                 RegisterClosure[]
  hygieneRapportsUpdated           HygieneRapport[]
  reportsFiled                     Report[]

  // Multi-tenancy: MediAfrica is a multi-tenant SaaS — each User belongs to
  // exactly one Organization (health center) via `memberships`
  // (OrganizationMember gets @@unique([userId]) once backfilled — see
  // enforce_multitenancy_constraints migration). Platform ADMIN/SUPERADMIN
  // accounts (role above) are independent of clinic membership.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Per-organization clinic settings — one row per health center tenant.
// ───────────────────────────────────────────────────────────────────────
model ClinicSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @default("CSRéf Bamako V")
  updatedAt      DateTime     @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
// Organization = a health center tenant (MediAfrica is multi-tenant SaaS).
// Each Organization has exactly one Subscription and one ClinicSettings row.
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  patients         Patient[]
  registerClosures RegisterClosure[]
  hygieneRapports  HygieneRapport[]
  clinicSettings   ClinicSettings?
  subscription     Subscription?
  orders           Order[]
  reports          Report[]

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
//
// `@@unique([userId])` enforces exactly one organization per user (locked
// scope decision — no multi-org staff, no org-switcher UI). The compound
// `@@unique([organizationId, userId])` stays for `requireOrgRole`'s lookup
// shape.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@unique([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id             String        @id @default(cuid())
  userId         String? // nullable — guest checkout supported
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Subscription billing — nullable so Order stays usable for non-subscription
  // charges too. Set together: an Order created by the billing engine always
  // carries both.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Int // gross amount, smallest unit
  currency       String        @default("XOF") // ISO 4217
  status         String        @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail  String?
  customerPhone  String?
  customerName   String?
  metadata       Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
  @@index([organizationId, createdAt])
}

model Patient {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dossierNumber  String       @unique // "P-20250187"
  nom            String
  prenom         String
  dateNaissance  DateTime
  sexe           String // M | F

  telephonePrincipal      String
  telephoneSecondaire     String?
  communeResidence        String
  quartierVillage         String?
  contactUrgenceNom       String?
  contactUrgenceTelephone String?
  numeroRamed             String?
  numeroAmo               String? // Assurance Maladie Obligatoire — distinct from RAMED

  groupeSanguin           String? // A+ | A- | B+ | B- | AB+ | AB- | O+ | O- | Inconnu
  allergiesConnues        String?
  antecedentsPersonnels   String?
  antecedentsChirurgicaux String?
  antecedentsFamiliaux    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultations            Consultation[]
  maternites               Maternite[]
  nutritions               Nutrition[]
  vaccinations             Vaccination[]
  hospitalisations         Hospitalisation[]
  planificationsFamiliales PlanificationFamiliale[]

  @@index([nom, prenom])
  @@index([communeResidence])
  @@index([createdAt])
  @@index([organizationId])
}

model Consultation {
  id         String  @id @default(cuid())
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  providerId String?
  provider   User?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  date   DateTime @default(now())
  motif  String
  status String   @default("attente") // attente | consultation | traite | urgent

  diagnostic          String?
  traitementPrescrit  String?
  tensionArterielle   String? // "118/76"
  poidsKg             Float?
  tailleCm            Float?
  perimetreBrachialCm Float? // PB - périmètre brachial (cm), dépistage malnutrition
  statutPT            String? // P/T - statut nutritionnel poids/taille (texte libre, lu sur abaque OMS)
  temperatureC        Float?

  typeCas    String? // NC | AC (Nouveau Cas | Ancien Cas)
  mdo        Boolean @default(false) // maladie à déclaration obligatoire
  mdoMaladie String? // nom de la maladie si mdo=true

  tdr String? // Test de Diagnostic Rapide (paludisme) - Positif | Négatif | Non fait
  ge  String? // Goutte Épaisse (paludisme) - Positif | Négatif | Non fait

  // Contact joignable (peut différer du téléphone habituel du patient) +
  // adresse précise, et statut indigent (prise en charge/exonération).
  indigent            Boolean?
  telephoneContact    String?
  localisationPrecise String?

  // RMA — rapport de morbidité et de mortalité (section 7) : code+libellé de
  // l'affection officielle (ex: "A00 — Choléra") si renseigné à la saisie, et
  // décès imputé à cette affection pendant cette consultation. Optionnels —
  // seules les consultations créées après l'ajout de ces champs les renseignent.
  codeAffection String?
  deces         Boolean?

  // Offline-queue replay safety — same pattern as Order.idempotencyKey.
  // Nullable so existing rows are unaffected; a retried sync with the same
  // key returns the original row instead of duplicating it. The hash lets
  // us detect (and reject) a key reused for a genuinely different body.
  idempotencyKey      String? @unique
  idempotencyBodyHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
  @@index([status, date])
}

// Une fiche de maternité — CPN (consultation prénatale), Accouchement ou CPoN
// (consultation postnatale), discriminées par `type` dans une seule table à
// plat (même principe que Consultation, qui mélange déjà anthropométrie +
// paludisme + MDO). Contrairement à Consultation, il n'y a pas de file
// d'attente ni de statut : une fiche est créée au moment de l'acte et reste
// immuable (aucune route d'édition).
model Maternite {
  id         String  @id @default(cuid())
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  providerId String?
  provider   User?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  date DateTime @default(now())
  type String // CPN | ACCOUCHEMENT | CPON

  // Communs
  gestite           Int?
  parite            Int?
  dpa               DateTime?
  ddr               DateTime?
  statutMatrimonial String? // colonne "Statut matrimonial" des registres papier CPN/Accouchement
  profession        String? // colonne "Profession" du registre papier CPoN
  observations      String?

  // Saisis uniquement pour CPN et Accouchement (pas CPoN — déjà capturés en
  // amont) : contact joignable (peut différer du téléphone habituel du
  // patient) + adresse précise, et statut indigent (prise en charge).
  indigent            Boolean?
  telephoneContact    String?
  localisationPrecise String?

  // CPN — champs alignés sur le registre papier "Consultation prénatale"
  cpnNumeroVisite           Int? // colonnes "CPN 1ère/2ème/3ème/4ème" du registre
  ageGestationnelSemaines   Int?
  poidsKg                   Float?
  tailleCm                  Float? // taille de la mère (cm)
  perimetreBrachialCm       Float? // PB de la mère (cm), dépistage malnutrition
  temperatureC              Float?
  tensionArterielle         String?
  hauteurUterineCm          Float?
  bruitsCoeurFoetal         String? // Perçus | Non perçus
  mouvementsFoetaux         String? // Perçus | Non perçus
  oedemes                   Boolean?
  nombreAvortements         Int?
  nombreEnfantsVivants      Int? // colonne "Nbre enfant en vie"
  groupeSanguin             String?
  testEmmel                 String? // dépistage drépanocytose - Positif | Négatif | Non fait
  bw                        String? // B.W. (syphilis) - Positif | Négatif | Non fait
  tauxHb                    Float? // taux d'hémoglobine (g/dl)
  tpiDose                   Int? // colonnes "SP 1ère à 6ème dose"
  moustiquaireImpregnee     Boolean? // colonne "MILD1"
  vatDose                   Int? // colonnes "Td 1ère dose/2ème dose/Rappel" (Rappel = 3)
  ferAcideFolique           Boolean?
  ferAcideFoliqueDoseNumero Int? // numéro de dose (1 à 4) remise à cette visite
  albendazoleMebendazole    Boolean? // colonne partagée CPN + Accouchement + CPoN
  albuminurie               String? // Positif | Négatif | Non fait
  glycosurie                String? // Positif | Négatif | Non fait
  vih                       String? // Positif | Négatif | Non fait | Connu positif
  planAccouchement          String?
  risqueGrossesse           String?
  maladieDetectee           String?
  prochainRdv               DateTime?

  // Accouchement — champs alignés sur le registre papier "Accouchement"
  dateHeureEntree             DateTime? // date/heure d'admission, distincte de `date` (accouchement)
  enfantPrecedent             String? // Vivant | Décédé | Mort-né | Avortement
  intervalleGrossessesMois    Int? // intervalle entre les 2 dernières grossesses, en mois
  lieuAccouchement            String? // Maternité | Domicile
  natureAccouchement          String? // Avant terme | À terme | Post-terme
  presentation                String?
  modeAccouchement            String? // Voie basse | Césarienne | Instrumental
  gatpa                       Boolean?
  avortementType              String? // colonne "Type" (Avortement)
  methodeEvacuationAvortement String?
  dureeTravailHeures          Float?
  assistePar                  String? // Sage-femme | Médecin | Matrone | Auxiliaire
  vitamineA                   Boolean?
  issueGrossesse              String? // Vivant | Mort-né frais | Mort-né macéré
  sexeNouveauNe               String? // M | F
  misAuSein                   Boolean?
  smk                         Boolean? // Soins Mère Kangourou
  tetracyclinePommade         Boolean?
  chlorhexidineDigluconate    Boolean?
  poidsNaissanceG             Float?
  tailleNaissanceCm           Float? // taille du nouveau-né (cm)
  apgar1min                   Int?
  apgar5min                   Int?
  perimetreCranienCm          Float?
  reanimationNouveauNe        Boolean?
  decesNouveauNeDelai         String? // 24 heures | 7 jours | 28 jours
  causesDeces                 String? // causes de décès du nouveau-né
  decesMaternelMoment         String? // Avant | Pendant | Après (l'accouchement)
  causesDecesMaternel         String?
  praticienQualification      String?
  complicationsAccouchement   String? // complications - mère
  complicationsNouveauNe      String?
  episiotomie                 Boolean?
  placentaComplet             Boolean?

  // CPoN — champs alignés sur le registre papier "Consultation post-natale"
  cponNumeroVisite       Int?
  cponTypeCas            String? // NC | AC (nouveau cas / ancien cas de consultation post-natale)
  dateAccouchementCpon   DateTime? // date réelle de l'accouchement (distincte de `dpa`, la date prévue)
  joursPostPartum        Int?
  etatSeins              String? // Normal | Anormal
  etatConjonctives       String?
  involutionUterine      String?
  etatLochies            String? // Normal | Anormal
  etatPerinee            String? // Normal | Anormal
  etatCol                String? // Normal | Anormal
  allaitement            String? // Exclusif | Mixte | Aucun
  planificationFamiliale String?
  etatNouveauNeCpon      String? // Bien portant | Malade | Décédé
  vaccinationBcgFait     Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
  @@index([type, date])
}

// Une fiche PCIMA (Prise en Charge Intégrée de la Malnutrition Aiguë) —
// URENI (hospitalisation), URENAS (ambulatoire sévère) ou URENAM
// (ambulatoire modéré), discriminées par `type`, même principe que
// Maternite. Les 3 types suivent le même schéma deux-temps que
// Hospitalisation : admission à la création, sortie/issue remplie plus
// tard via PATCH (les champs de sortie restent nullables). Les 3 types
// gagnent aussi des visites de suivi ajoutées une à une (voir
// NutritionVisiteSuivi — quotidien pour URENI, hebdomadaire pour URENAS,
// existant pour URENAM), modélisées comme un tableau enfant plutôt qu'une
// ligne plate par visite. URENAS a en plus des évènements ponctuels (VAD,
// référence/transfert durant le traitement — voir NutritionEvenement).
model Nutrition {
  id         String  @id @default(cuid())
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  providerId String?
  provider   User?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  date DateTime @default(now()) // date d'admission / de création de l'épisode
  type String // URENI | URENAS | URENAM

  // Communs — admission / épisode
  numeroMas            String? // N° MAS (numéro d'enregistrement programme)
  telephoneContact     String?
  localisationPrecise  String?
  ageMois              Int?
  modeAdmission        String? // URENI: NC|Rechute|Réadmission|TN/REF — URENAS: mêmes + TN/TM
  typeCas              String? // URENAM uniquement : NC | AC | Réadmission
  poidsKg              Float?
  tailleCm             Float?
  perimetreBrachialCm  Float?
  ptIndice             String? // "P/T ou IMC" (URENI) ou "P/T Z" (URENAS/URENAM)
  oedemes              String? // Non | + | ++ | +++
  pathologiesAssociees String?

  // Contexte admission — sourceAdmission + provenanceProgramme s'appliquent aux
  // 3 types ; le reste de ce bloc (nomPere...vaccinationAJour) reste
  // URENI/URENAS uniquement. Saisi à la création uniquement, pas de PATCH.
  nomPere             String?
  nomMere             String?
  allaite             Boolean?
  jumeaux             Boolean?
  parentsVivants      Boolean?
  sourceAdmission     String? // Référé | Spontané | Dépistage actif — distinct de modeAdmission (classification PCIMA officielle)
  provenanceProgramme String? // URENI | URENAS | URENAM — programme PCIMA d'origine si sourceAdmission = 'Référé' (URENAM jamais concerné : c'est le point d'entrée, pas de provenance PCIMA)
  carteVaccination    Boolean?
  vaccinationAJour    Boolean?

  // Sortie / issue finale (nullable, rempli plus tard via PATCH sur
  // /api/nutritions/[id] — jamais via prisma.nutrition.update ailleurs)
  dateSortie                        DateTime?
  poidsSortieKg                     Float?
  tailleSortieCm                    Float?
  perimetreBrachialSortieCm         Float?
  ptIndiceSortie                    String?
  oedemeSortie                      String?
  typeSortie                        String? // Guéri|Décès|Abandon|Non répondant|Transféré/référé|Perdu de vue
  destinationProgramme              String? // URENI | URENAS | URENAM | Autre structure — si typeSortie = 'Transféré/référé'. Distinct de NutritionEvenement.centre (journal texte libre en cours de traitement, URENAS only) : ce champ est la valeur structurée unique de l'issue finale, pour les 3 types.
  datePoidsMinimum                  DateTime? // URENI/URENAS
  poidsMinimumKg                    Float? // URENI/URENAS
  seancesStimulationPsychocognitive Int? // URENI/URENAS
  seancesCcsc                       Int? // URENI/URENAS
  beneficiairePoudreNutritive       Boolean? // URENAM
  beneficiairePlaquette             Boolean? // URENAM
  dureeSejourJours                  Int? // URENAM
  observations                      String?

  visites    NutritionVisiteSuivi[] // URENI: quotidien, URENAS: hebdomadaire, URENAM: existant
  evenements NutritionEvenement[] // URENAS uniquement : VAD + référence/transfert

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
  @@index([type, date])
}

// Visite de suivi périodique, ajoutée au fil du traitement via POST
// /api/nutritions/[id]/visites — quotidien pour URENI, hebdomadaire pour
// URENAS, existant pour URENAM. Pas de organizationId propre — le scoping
// tenant passe par nutrition -> patient -> organization, comme tout le
// reste du schéma.
model NutritionVisiteSuivi {
  id          String    @id @default(cuid())
  nutritionId String
  nutrition   Nutrition @relation(fields: [nutritionId], references: [id], onDelete: Cascade)

  numeroVisite        Int
  date                DateTime @default(now())
  poidsKg             Float?
  tailleCm            Float?
  perimetreBrachialCm Float?
  ptIndice            String?
  oedemes             String?
  type                String? // statut/issue de cette visite (texte libre)

  // Suivi clinique pragmatique — URENI: quotidien, URENAS: hebdomadaire, URENAM: existant
  testAppetit                    String? // Bon | Moyen | Faible
  diarrheeJours                  Int?
  vomissementJours               Int?
  fievreJours                    Int?
  touxJours                      Int?
  temperatureC                   Float?
  resultatTestPalu               String? // '0' | '-' | '+' — repris du papier tel quel (distinct de Consultation.tdr : Positif/Négatif/Non fait)
  atpeSachets                    Int?
  dermatoses                     String?
  alerteLethargique              String? // Alerte | Léthargique — surveillance quotidienne URENI
  frequenceRespiratoireMin       Int?
  seancesEducationNutritionnelle Int? // par visite — distinct de Nutrition.seancesCcsc (cumulatif, sortie)
  seancesStimulation             Int? // par visite — distinct de Nutrition.seancesStimulationPsychocognitive (cumulatif, sortie)
  observations                   String? // texte libre : médicaments, traitement spécifique, labo…

  createdAt DateTime @default(now())

  @@unique([nutritionId, numeroVisite])
}

// Évènement ponctuel durant le traitement URENAS — VAD (visite à domicile)
// ou référence/transfert. Contrôle de type applicatif uniquement (POST
// route), pas de contrainte au niveau du schéma, même principe que
// NutritionVisiteSuivi pour URENAM avant l'ouverture aux 3 types. Pas de
// organizationId propre — scoping transitif via nutrition -> patient ->
// organization.
model NutritionEvenement {
  id          String    @id @default(cuid())
  nutritionId String
  nutrition   Nutrition @relation(fields: [nutritionId], references: [id], onDelete: Cascade)

  type       String // VAD | REFERENCE_TRANSFERT
  date       DateTime @default(now())
  raison     String?
  conclusion String? // VAD uniquement
  centre     String? // REFERENCE_TRANSFERT uniquement
  resultat   String? // REFERENCE_TRANSFERT uniquement

  createdAt DateTime @default(now())

  @@index([nutritionId, date])
}

// Une dose de vaccin administrée — PEV (Programme Élargi de Vaccination,
// calendrier vaccinal Mali). Un événement par ligne, immuable, même
// principe que Nutrition/Consultation.
model Vaccination {
  id         String  @id @default(cuid())
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  providerId String?
  provider   User?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  date     DateTime @default(now())
  antigene String // BCG | VPO0-3 | Penta1-3 | Pneumo1-3 | Rota1-2 | VAR1-2 | VAA | VitamineA | MenA…

  numeroDose         Int?
  voieAdministration String? // Orale | Intramusculaire | Sous-cutanée | Intradermique
  siteInjection      String? // Bras droit | Bras gauche | Cuisse droite | Cuisse gauche | Bouche
  numeroLot          String?
  effetsSecondaires  String? // sert aussi de MAPI/EIM (manifestation post-vaccinale indésirable)

  // Bloc PFPP/AME du registre PEV officiel (colonnes 46-51) — counseling
  // planification familiale du post-partum + allaitement maternel exclusif,
  // rempli à la même visite que la vaccination.
  dejaSousContraception          Boolean?
  methodeContraceptivePrecedente String?
  pfppCounselingPropose          Boolean?
  methodePfAdoptee               String?
  conseilsAme                    String? // O | N | NA
  pratiqueAme                    String? // O | N | NA

  prochainRdv  DateTime?
  observations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
}

// Une hospitalisation — seul registre en deux temps : la fiche est créée à
// l'admission (POST) puis complétée à la sortie (PATCH, tant que le mois de
// `dateHeureEntree` n'est pas clôturé) — contrairement à
// Consultation/Maternite/Nutrition/Vaccination qui sont immuables après
// création. `dateHeureSortie == null` signifie que le patient est toujours
// hospitalisé.
model Hospitalisation {
  id         String  @id @default(cuid())
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  providerId String?
  provider   User?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  dateHeureEntree DateTime @default(now())
  motifAdmission  String
  // Médecine | Chirurgie | Pédiatrie | Maternité | Réanimation | Urgences |
  // Néonatologie | Autre — free-text service, covered by the single
  // hospitalisation register (frontend/src/app/registres/hospitalisation).
  service         String?

  // Registre des hospitalisés officiel : numéro d'ordre du cahier papier
  // (distinct du dossierNumber du patient) + provenance codée + profession.
  numeroHospitalisation String?
  referenceOrigine      String? // Non référé | Cscom | Csref | HR | HN | Cabinet Med Privé | Cabinet soins Privé | Clinique privée
  profession            String?

  // Contact joignable pendant l'hospitalisation (peut différer du
  // téléphone habituel du patient, ex. un accompagnant) + adresse précise
  // pour le retrouver, et statut indigent (prise en charge/exonération).
  indigent            Boolean?
  telephoneContact    String?
  localisationPrecise String?

  diagnosticPrincipal    String?
  diagnosticsSecondaires String?
  traitementRecu         String?

  dateHeureSortie      DateTime?
  issue                String? // Sortie médicale | Référé vers autre structure | Décédé | Transféré vers autre service | Abandon
  causeDeces           String?
  structureReference   String?
  praticienResponsable String?
  observations         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, dateHeureEntree])
}

// Une visite de planification familiale. Un événement par ligne, immuable,
// même principe que Nutrition/Vaccination/Consultation.
model PlanificationFamiliale {
  id         String  @id @default(cuid())
  patientId  String
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  providerId String?
  provider   User?   @relation(fields: [providerId], references: [id], onDelete: SetNull)

  date           DateTime @default(now())
  typeVisite     String // Nouvelle acceptante | Cliente continuante | Changement de méthode | Retrait/Abandon
  methodeChoisie String // DIU | Pilule COC | Pilule COP | Jadelle | Implanon | DMPA-IM | DMPA-SC | MAMA | Collier | CCV | Condom masculin | Condom féminin | Autre

  // Tableau méthode × action du registre de consultation PF officiel :
  // l'action possible dépend de methodeChoisie (ex. DIU → Per Césarienne |
  // Post placentaire | PPI 48H | Insertion | Réinsertion | Retrait |
  // Suivi/Contrôle ; Pilule COC/COP → 1ère dotation | Renouvellement |
  // PPI 48H | Suivi/Contrôle ; Jadelle/Implanon → Insertion | PPI 48H |
  // Retrait | Suivi/Contrôle ; DMPA-IM/DMPA-SC → 1ère injection |
  // Auto-injection | Renouvellement | Suivi/Contrôle ; MAMA → Pratique ;
  // CCV → Pratique (per césarienne) | Pratique (en dehors césarienne) ;
  // Collier → Dotation).
  actionMethode        String?
  nbreCyclesDistribues Int? // Pilule COC/COP uniquement

  methodePrecedente          String?
  parite                     Int?
  gestite                    Int?
  tensionArterielle          String?
  poidsKg                    Float?
  counselingDonne            Boolean?
  effetsSecondairesRapportes String?
  quantiteRemise             String?

  typeUtilisateur                String? // Nouveau | Ancien
  ageDernierEnfantMois           Int?
  pratiqueAme                    String? // O | N | NA
  enfantAJourVaccins             String? // O | N | NA
  conseilsAlimentationComplement String? // O | N | NA
  serviceProvenance              String? // Accouchement | CPoN | SPE | Vaccination | Post avortement
  ppi                            Boolean? // Visite en post-partum immédiat (≤ 48h)

  prochainRdv  DateTime?
  observations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, date])
}

// Clôture mensuelle d'un registre (registre de consultation et, depuis
// maternité, un registre distinct par type d'acte — consultation |
// maternite-cpn | maternite-accouchement | maternite-cpon | nutrition |
// vaccination | hospitalisation | planification-familiale). Une fois un
// mois clôturé, les routes de mutation refusent (REGISTER_CLOSED) — voir
// lib/server/registers/closure.ts.
model RegisterClosure {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registerType   String       @default("consultation")
  month          String // "2026-01"
  closedAt       DateTime     @default(now())
  closedById     String?
  closedBy       User?        @relation(fields: [closedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, registerType, month])
}

// RMA — section "Activités d'hygiène publique et salubrité" : un seul
// enregistrement par organisation et par mois, saisi manuellement (pas de
// lien patient — ce sont des totaux d'infrastructure/assainissement, pas
// des évènements par patient). Compteurs regroupés par les 7 sous-parties
// officielles du RMA (numérotées ci-dessous) ; tous nullables (mois pas
// encore rempli, ou indicateur non applicable/non suivi par le centre).
model HygieneRapport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String // "2026-01"

  // 1. Hygiène de l'eau (surveillance/contrôle qualité eau de boisson)
  nbComparateursChlorePh         Int?
  nbNouveauxPuitsRealises        Int?
  nbPuitsExistants               Int?
  nbNouveauxPuitsAmenages        Int?
  nbPuitsTraites                 Int?
  nbNouveauxForagesRealises      Int?
  nbForagesExistants             Int?
  nbNouveauxForagesAmenages      Int?
  nbForagesFonctionnels          Int?
  nbAesExistants                 Int?
  nbAesChloreesAvantDistribution Int?
  nbControlesChloreEffectues     Int?
  nbControlesChloreNormes        Int?

  // 2. Hygiène de l'habitat et des établissements classés
  nbVisitesDomicileEffectuees     Int?
  nbConcessionsSourceEauPotable   Int?
  nbConcessionsLatrines           Int?
  nbConcessionsLatrinesAmeliorees Int?
  nbLatrinesDesinfectees          Int?
  nbConcessionsPuisard            Int?
  nbConcessionsDesinsectisees     Int?
  nbConcessionsDeratisees         Int?
  nbMenagesLavageMains            Int?
  nbEcolesPointEauPotable         Int?
  nbEcolesLavageMains             Int?
  nbEcolesLatrinesAmeliorees      Int?

  // 3. Hygiène des aliments (restauration collective)
  nbControlesIodationSel            Int?
  nbCasIntoxicationsAlimentaires    Int?
  nbTiacEnregistres                 Int?
  nbEtabsRestaurationExistants      Int?
  nbEtabsRestaurationInspectes      Int?
  nbEtabsRestaurationConformes      Int?
  nbInspectionsSanitairesEffectuees Int?
  nbVisitesMedicalesManipulateurs   Int?

  // 4. Accès à l'eau potable, hygiène et assainissement (AEP) dans les
  //    établissements de santé
  nbSourcesEauExistantesCS           Int?
  nbSourcesEauFonctionnellesCS       Int?
  nbPointsDistributionFonctionnelsCS Int?
  nbPointsDistributionExistantsCS    Int?
  nbReservoirsStockageExistantsCS    Int?
  nbReservoirsStockageFonctionnelsCS Int?
  nbControlesChloreCS                Int?
  nbControlesChloreNormesCS          Int?

  // 5. Gestion des eaux usées et excréta
  nbToilettesExistantesCS             Int?
  nbToilettesFonctionnellesCS         Int?
  nbToilettesSepareesCS               Int?
  nbToilettesHandicapCS               Int?
  nbToilettesLavageMainsCS            Int?
  nbDispositifsTraitementExistants    Int?
  nbDispositifsTraitementFonctionnels Int?

  // 6. Gestion des déchets biomédicaux
  nbKitsProtectionExistants   Int?
  nbUnitesSoinsTotal          Int?
  nbUnitesSoinsTriSource      Int?
  nbCsIncinerateurFonctionnel Int?
  nbBoitesSecuriteCollectees  Int?
  nbBoitesSecuriteConvoyees   Int?
  nbBoitesSecuriteIncinerees  Int?

  // 7. Prévention/contrôle des infections + promotion de l'hygiène
  nbUnitesSoinsLavageMainsFonctionnel   Int?
  nbPersonnelEquipementProtection       Int?
  nbPersonnelTotal                      Int?
  nbUnitesProduitsEntretien             Int?
  nbAppareilsSterilisationExistants     Int?
  nbAppareilsSterilisationFonctionnels  Int?
  nbComitesHygieneSalubrite             Int?
  nbComitesHygieneSalubriteFonctionnels Int?
  nbAteliersConfectionDalles            Int?
  nbSeancesSensibilisationRealisees     Int?
  nbSeancesSensibilisationPlanifiees    Int?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, month])
}

// ───────────────────────────────────────────────────────────────────────
// Subscription billing — SaaS layer on top of the multi-tenant clinics.
// Bictorys is checkout-link only (no stored-card silent recurring charge),
// so billing is invoice-then-pay-through-link: the subscription-billing
// cron creates a pending Order each period and emails the org owner a
// "pay now" link; there is no automatic charge.
// ───────────────────────────────────────────────────────────────────────
model Plan {
  id                  String   @id @default(cuid())
  name                String
  priceAmount         Int // smallest currency unit (XOF = FCFA, no decimals)
  currency            String   @default("XOF")
  billingIntervalDays Int      @default(30)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId                String
  plan                  Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                String       @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELED
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime
  // Reminder emails sent ahead of / just after `currentPeriodEnd`, one flag
  // per stage so the daily billing cron never re-sends the same reminder.
  // Cleared back to null whenever the period is renewed (paid or manually
  // reactivated) so the next cycle's reminders fire again.
  reminder7dSentAt      DateTime?
  reminder5dSentAt      DateTime?
  reminder3dSentAt      DateTime?
  reminderOverdueSentAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  orders Order[]

  @@index([status, currentPeriodEnd])
}

// Staff-submitted reports/flags (bugs, support requests, billing issues) —
// reviewed by the platform admin under /admin/signalements.
model Report {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporterId       String
  reporter         User         @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  category         String // feature area the comment is about: patients | consultations | registres | facturation | personnel | autre
  message          String
  // Optional 1-5 satisfaction rating — lets staff leave a quick pulse-check
  // alongside (or instead of) free text.
  rating           Int?
  status           String       @default("OPEN") // internal admin triage only — never shown to staff as a ticket state
  // A visible reply from the platform admin, shown back to the reporting
  // clinic under their own comment — makes this a two-way feedback channel
  // rather than a one-way report queue.
  adminResponse    String?
  adminRespondedAt DateTime?
  createdAt        DateTime     @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([organizationId])
}
