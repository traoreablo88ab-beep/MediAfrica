  rechSchistoPositif       Int?
  pvDirectTotal            Int?
  pvDirectPositif          Int?
  puDirectTotal            Int?
  puDirectPositif          Int?
  rechMicrofilairesTotal   Int?
  rechMicrofilairesPositif Int?

  // Transfusion (valeur unique, pas de paire Total/Positif)
  nbPochesDisponibles  Int?
  nbPatientsTransfuses Int?

  // Imagerie médicale (CSRéf uniquement — reste null côté CSCom)
  nbGraphiesRealisees     Int?
  nbEchographiesRealisees Int?
  imagerieAutres          Int?

  // Anesthésie (CSRéf uniquement — reste null côté CSCom)
  anesthesieLocale        Int?
  anesthesieLocoRegionale Int?
  anesthesieGenerale      Int?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, month])
}

// RMA — section 6 "Gestion des stocks des médicaments du panier / PF /
// Paludisme / SMI", intrants de nutrition et vaccins/consommables. Une
// ligne par (organisation, mois, article) plutôt qu'une colonne à plat par
// article — le grand livre complet (~111 articles × jusqu'à 10 colonnes)
// représenterait ~900 colonnes individuelles sur un seul modèle, ingérable
// en schéma comme en formulaire. La liste canonique des articles (clé,
// libellé, catégorie) vit en code, pas en DB — voir
// lib/server/registers/stock-items.ts. Les 7 champs `perdu*`/`datePeremption`/
// `numeroLot` ne sont renseignés que pour category="vaccins" (structure de
// colonnes différente dans le RMA officiel : perte détaillée + numéro de
// lot) ; ils restent null pour les autres catégories.
model StockLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String // "2026-01"
  category       String // 'panier' | 'pf' | 'paludisme' | 'smi' | 'nutrition' | 'vaccins'
  itemKey        String // slug stable, voir STOCK_ITEMS

  // Colonnes communes à toutes les catégories
  quantiteDebut     Int?
  quantiteRecue     Int?
  consommation      Int?
  quantiteAjustee   Int?
  raisonsAjustement String?
  joursRuptureStock Int?
  raisonsRupture    String?
  quantiteFin       Int?
  quantiteCommandee Int?
  raisonsMiseAJour  String?

  // Colonnes propres à category="vaccins" (null pour les autres catégories)
  perduPcvViree      Int?
  perduCongele       Int?
  perduPerime        Int?
  perduCasse         Int?
  perduAutresAvaries Int?
  datePeremption     String?
  numeroLot          String?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, month, itemKey])
  @@index([organizationId, month, category])
}

// RMA — sections 1 (fonctionnement du centre / santé et décentralisation) et
// 2 (ressources humaines/matérielles/financières), confirmées par le texte
// "Section 1"/"Section 2" des deux PDF officiels. Contrairement à
// Laboratoire/Stock ce n'est pas un domaine clinique — RH, matériel,
// comptabilité — donc pas de champ dérivable d'une consultation existante.
// Les compteurs plats (Section 1, source d'énergie, 4 bilans financiers par
// échelon) vivent ici ; Personnel/Équipements/Visites-réunions sont des
// listes à cardinalité variable, donc des tables séparées (PersonnelLine,
// EquipmentLine, VisiteReunionLine) — même raisonnement que StockLine.
// Champs préfixés csref*/cscom* quand la structure diffère entre échelons ;
// non préfixés quand partagés (source d'énergie) ou quand les deux échelons
// utilisent la même forme A-H (bilans médicaments/compte d'exploitation).
model RessourcesRapport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String // "2026-01"

  // Section 1 — CSRéf (Santé et décentralisation, 3 questions)
  csrefAppuiConseilCercle Boolean?
  csrefConseilGestionTenu Boolean?
  csrefAutreAppui         String?

  // Section 1 — CSCom (fonctionnement du centre + ASACO/genre)
  cscomNbJoursFermeture       Int?
  cscomNbReunionsConseilAdmin Int?
  cscomAsacoSubventionMairie  Boolean?
  cscomAsacoConventionSignee  Boolean?
  cscomCaHommes               Int?
  cscomCaFemmes               Int?
  cscomComiteGestionHommes    Int?
  cscomComiteGestionFemmes    Int?

  // Section 2 — Source d'énergie (partagé CSRéf/CSCom)
  energieEdm               Boolean?
  energieGroupeElectrogene Boolean?
  energieSolaire           Boolean?

  // Section 3 — Provenance et circonstances de prise en charge (CSRéf
  // uniquement ; regroupement colonne par colonne à reconfirmer visuellement
  // contre le PDF page 4-5, l'extraction texte a mélangé l'ordre des
  // en-têtes multi-niveaux — seule la liste des 12 compteurs est fiable)
  provenanceCurativeReferesAdresses      Int?
  provenanceCurativeReferesPrisEnCharge  Int?
  provenanceCurativeEvacuesAdresses      Int?
  provenanceCurativeEvacuesPrisEnCharge  Int?
  provenanceGrossesseReferesAdresses     Int?
  provenanceGrossesseReferesPrisEnCharge Int?
  provenanceGrossesseEvacuesAdresses     Int?
  provenanceGrossesseEvacuesPrisEnCharge Int?
  provenancePfReferesAdresses            Int?
  provenancePfReferesPrisEnCharge        Int?
  provenancePfEvacuesAdresses            Int?
  provenancePfEvacuesPrisEnCharge        Int?

  // Bilan financier — Laboratoire (CSRéf + CSCom, même structure A-D)
  laboFinancierRecettesAttendues Int?
  laboFinancierRecettesVersees   Int?
  laboFinancierDepenses          Int?
  laboFinancierSolde             Int?

  // Bilan financier — Hors médicaments (CSRéf : solde simple)
  csrefHorsMedSoldeDebut    Int?
  csrefHorsMedTotalRecettes Int?
  csrefHorsMedTotalDepenses Int?
  csrefHorsMedSoldeFin      Int?

  // Bilan financier — Hors médicaments (CSCom : détaillé par poste)
  cscomHorsMedBanqueDebut             Int?
  cscomHorsMedCaisseDebut             Int?
  cscomHorsMedRecTarification         Int?
  cscomHorsMedRecTransfertCaisseMed   Int?
  cscomHorsMedRecCotisations          Int?
  cscomHorsMedRecReferenceEvacuation  Int?
  cscomHorsMedRecCarteAdhesion        Int?
  cscomHorsMedRecAutres               Int?
  cscomHorsMedDepSalaires             Int?
  cscomHorsMedDepAutresFonctionnement Int?
  cscomHorsMedBanqueFin               Int?
  cscomHorsMedCaisseFin               Int?

  // Bilan financier — Médicaments (CSRéf + CSCom, même structure A-H)
  medCapitalInitial     Int?
  medValeurFinPeriode   Int?
  medBanqueDebut        Int?
  medCaisseFin          Int?
  medCreancesFin        Int?
  medDettesFin          Int?
  medCapitalFin         Int?
  medIndicateurMaintien Float?

  // Compte d'exploitation médicaments (CSRéf + CSCom)
  compteValeurDebut          Int?
  compteValeurFin            Int?
  compteVariationStock       Int?
  compteAchatMedicaments     Int?
  compteAppuiTarification    Int?
  compteSalairesGerant       Int?
  compteAutresFonctionnement Int?
  compteTotalCharges         Int?
  compteRecettesVenteMed     Int?
  compteAutresRecettes       Int?
  compteTotalRecettes        Int?
  compteResultat             Int?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, month])
}

// RMA section 2 — personnel. Une ligne par (organisation, mois, poste).
// CSRéf : liste canonique de catégories de poste avec un effectif agrégé par
// catégorie (voir PERSONNEL_CATEGORIES_CSREF dans ressources-items.ts).
// CSCom : liste libre, une ligne par agent nommé (itemKey généré côté
// client, pas de liste canonique) — le RMA 1er échelon liste le personnel
// individuellement, pas par catégorie agrégée.
model PersonnelLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String // "2026-01"
  echelon        String // 'csref' | 'cscom'
  itemKey        String // clé canonique (CSRéf) ou id généré (CSCom, ligne libre)
  qualification  String // libellé du poste (fixe CSRéf, saisi CSCom)

  sexe                       String? // 'H' | 'F' — CSCom
  fonctionResponsabilite     String? // CSCom
  effectifOfficiel           Int? // CSRéf
  priseEnChargeSalaire       String?
  absenceFormation           Int?
  absenceRaisonsService      Int?
  absenceRaisonsPersonnelles Int?
  absenceDureeTotale         Int?
  observations               String?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, month, itemKey])
  @@index([organizationId, month, echelon])
}

// RMA section 2 — matériel. Communication (Téléphone/Fax/Internet,
// canonique, partagé) et véhicules (canonique par échelon — voir
// EQUIPMENT_ITEMS) partagent les 6 colonnes communes ; réfrigérateurs et
// congélateurs numérotés 1-5 (CSCom uniquement) ajoutent des relevés de
// température/alarme à deux moments de la journée (8h et 14h), null pour
// les autres catégories.
model EquipmentLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String // "2026-01"
  category       String // 'communication' | 'vehicule' | 'refrigerateur' | 'congelateur'
  itemKey        String // slug canonique, voir EQUIPMENT_ITEMS
  label          String

  nombreFonctionnel Int?
  nombreEnPanne     Int?
  joursArretPanne   Int?
  naturePanne       String?
  reparationsFaites Boolean?
  nombreRepare      Int? // communication uniquement

  // Réfrigérateur / congélateur (CSCom) — relevés à deux moments de la journée
  tempMin8h        Float?
  tempMax8h        Float?
  nbAlarmeBasse8h  Int?
  nbAlarmeHaute8h  Int?
  tempMin14h       Float?
  tempMax14h       Float?
  nbAlarmeBasse14h Int?
  nbAlarmeHaute14h Int?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, month, itemKey])
  @@index([organizationId, month, category])
}

// RMA section 1 — visites de supervision et réunions du CSCom (5
// mini-tableaux : supervision équipe district, autres visites, supervision
// équipe CSCom, sessions de monitorage, réunions du conseil
// d'administration). Liste ouverte (jusqu'à ~5 lignes par tableau), itemKey
// généré côté client comme les lignes libres de PersonnelLine — aucun de ces
// tableaux n'a de liste canonique dans le RMA officiel (dates/nature saisies
// librement chaque mois). N'existe pas côté CSRéf (Section 1 y est juste 3
// questions OUI/NON sur RessourcesRapport).
model VisiteReunionLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String // "2026-01"
  tableau        String // 'supervision_district' | 'autres_visites' | 'supervision_cscom' | 'monitorage' | 'conseil_administration'
  itemKey        String // id généré côté client

  type                 String? // nature/type de la visite
  datePrevue           String? // ou "date d'arrivée" pour autres_visites
  dateRealisation      String? // ou "date de retour" pour autres_visites
  nombreJours          Int?
  integreeOuSpecifique String? // supervision_district uniquement
  numeroCompteRendu    String? // conseil_administration uniquement
  decision1            String?
  decision2            String?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, month, itemKey])
  @@index([organizationId, month, tableau])
}

// ───────────────────────────────────────────────────────────────────────
// Subscription billing — SaaS layer on top of the multi-tenant clinics.
// Bictorys is checkout-link only (no stored-card silent recurring charge),
// so billing is invoice-then-pay-through-link: the subscription-billing
// cron creates a pending Order each period and emails the org owner a
// "pay now" link; there is no automatic charge.
// ───────────────────────────────────────────────────────────────────────
model Plan {
  id                  String   @id @default(cuid())
  name                String
  priceAmount         Int // smallest currency unit (XOF = FCFA, no decimals)
  currency            String   @default("XOF")
  billingIntervalDays Int      @default(30)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId                String
  plan                  Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                String       @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELED
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime
  // Reminder emails sent ahead of / just after `currentPeriodEnd`, one flag
  // per stage so the daily billing cron never re-sends the same reminder.
  // Cleared back to null whenever the period is renewed (paid or manually
  // reactivated) so the next cycle's reminders fire again.
  reminder7dSentAt      DateTime?
  reminder5dSentAt      DateTime?
  reminder3dSentAt      DateTime?
  reminderOverdueSentAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  orders Order[]

  @@index([status, currentPeriodEnd])
}

// Staff-submitted reports/flags (bugs, support requests, billing issues) —
// reviewed by the platform admin under /admin/signalements.
model Report {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporterId       String
  reporter         User         @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  category         String // feature area the comment is about: patients | consultations | registres | facturation | personnel | autre
  message          String
  // Optional 1-5 satisfaction rating — lets staff leave a quick pulse-check
  // alongside (or instead of) free text.
  rating           Int?
  status           String       @default("OPEN") // internal admin triage only — never shown to staff as a ticket state
  // A visible reply from the platform admin, shown back to the reporting
  // clinic under their own comment — makes this a two-way feedback channel
  // rather than a one-way report queue.
  adminResponse    String?
  adminRespondedAt DateTime?
  createdAt        DateTime     @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([organizationId])
}

// ───────────────────────────────────────────────────────────────────────
// Guichet & transparence financière — front-desk receipt-issuance module
// (see .planning/prd-guichet-entree.md). Core anti-fraud invariant:
// `createdAt`/`numeroSequence` are server-derived and never accepted from
// the client (see lib/server/guichet/numero-sequence.ts); a
// GuichetTransaction is immutable once emitted (statut = "emise") — only
// POST .../annuler transitions it to "annulee", never a raw PUT/PATCH.
// Montants en Int (FCFA, pas de décimales) — même invariant que le reste
// de MediAfrica.
// ───────────────────────────────────────────────────────────────────────
model TypeRecette {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  libelle        String
  tarif          Int // FCFA
  actif          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions GuichetTransaction[]

  @@index([organizationId, actif])
}

model GuichetTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Strictly sequential per organization, gap-free except for a
  // corresponding "annulee" row — see generateNumeroSequence().
  numeroSequence Int

  patientNom String
  patientId  String?
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  typeRecetteId String
  // onDelete: Restrict — a TypeRecette with issued transactions can be
  // deactivated (actif=false) but never deleted, preserving history.
  typeRecette   TypeRecette @relation(fields: [typeRecetteId], references: [id], onDelete: Restrict)
  // Snapshot of the tariff actually applied at emission time (independent
  // of later changes to typeRecette.tarif).
  montant       Int // FCFA
  modePaiement  String // especes | mobile_money | exoneration

  guichetierId String
  guichetier   User   @relation("GuichetTransactionsEmises", fields: [guichetierId], references: [id], onDelete: Restrict)

  statut String @default("emise") // emise | annulee

  annulationMotif String?
  annulationParId String?
  annulationPar   User?     @relation("GuichetTransactionsAnnulees", fields: [annulationParId], references: [id], onDelete: SetNull)
  annulationAt    DateTime?

  // Écart tracé par rapport au tarif standard — jamais un montant libre non
  // justifié (voir règle d'alerte "montant hors grille").
  remiseAppliquee Int?
  remiseMotif     String?

  createdAt DateTime @default(now())

  @@unique([organizationId, numeroSequence])
  @@index([organizationId, createdAt])
  @@index([organizationId, guichetierId, createdAt])
}

// Phase 4 consumes this (alert-generation cron); the model ships in Phase 1
// alongside the other 3 tables per the PRD's phasing.
model GuichetAlerte {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  typeAlerte     String // ecart_caisse | hors_horaires | annulations_suspectes | inactivite | rupture_sequence | montant_hors_grille
  severite       String // info | attention | critique
  details        Json?
  vue            Boolean  @default(false)
  resolue        Boolean  @default(false)
  resolutionNote String?
  createdAt      DateTime @default(now())

  @@index([organizationId, resolue, createdAt])
  @@index([organizationId, severite])
}

// Phase 2 consumes this (clôture de caisse UI); the model ships in Phase 1
// alongside the other 3 tables per the PRD's phasing.
// dateService is always normalized to midnight (see the cloture route's
// dayKey()) so @@unique enforces one closure per guichetier per calendar
// day — re-closing the same day would otherwise silently recompute
// recetteTheorique from every transaction of the day again, not just those
// since the last closure.
model ClotureCaisse {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guichetierId     String
  guichetier       User         @relation("ClotureCaisseGuichetier", fields: [guichetierId], references: [id], onDelete: Restrict)
  dateService      DateTime
  recetteTheorique Int
  recetteRemise    Int
  ecart            Int
  createdAt        DateTime     @default(now())

  @@unique([organizationId, guichetierId, dateService])
  @@index([organizationId, dateService])
}
